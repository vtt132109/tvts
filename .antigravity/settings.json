{
  "$schema": "https://antigravity.google/schemas/settings.json",
  "autoApprove": {
    "readFiles": true,
    "writeFilesInAllowedPaths": true,
    "spawnSubagents": true
  },
  "circuitBreaker": {
    "enabled": true,
    "maxRetries": 3,
    "onThresholdExceeded": "halt_and_report_root_cause"
  },
  "contextFilter": {
    "enabled": true,
    "ignoreFile": ".antigravity/ignore",
    "deniedPaths": [
      "node_modules/**",
      ".next/**",
      "dist/**",
      "build/**",
      "out/**",
      "*.lock",
      "package-lock.json",
      "*.min.js",
      "*.min.css",
      "*.map",
      "*.png",
      "*.jpg",
      "*.jpeg",
      "*.gif",
      "*.ico",
      "*.webp",
      "*.svg",
      "*.mp4",
      "*.webm",
      "*.zip",
      "*.pdf"
    ]
  },
  "secretShield": {
    "enabled": true,
    "deniedPaths": [
      ".env*",
      "*.pem",
      "*.key",
      ".git/**",
      "node_modules/**",
      ".next/**",
      "dist/**",
      "build/**",
      "*.lock",
      "package-lock.json",
      "*.min.js",
      "*.map",
      "*.png",
      "*.jpg",
      "*.jpeg",
      "*.gif",
      "*.ico",
      "*.mp4",
      "*.webm",
      "*.zip"
    ],
    "denyRead": true,
    "denyWrite": true,
    "denyEcho": true
  },
  "dependencyFirewall": {
    "enabled": true,
    "requireUserApprovalForInstall": true,
    "preferExistingDependencies": true,
    "deniedCommands": [
      "npm install *",
      "npm i *",
      "yarn add *",
      "pnpm add *",
      "pip install *"
    ]
  },
  "terminalCommands": {
    "policy": "allowlist",
    "allowed": [
      "npm run *",
      "npx *",
      "node *",
      "pytest*",
      "gcc *",
      "g++ *",
      "git status*",
      "git diff*",
      "git log*",
      "git add .",
      "git commit -m \"chore(checkpoint):*\"",
      "git checkout -b agent/*",
      "git switch -c agent/*",
      "git stash push -u -m \"agent-checkpoint*\""
    ],
    "denied": [
      "npm install *",
      "npm i *",
      "yarn add *",
      "pnpm add *",
      "pip install *",
      "rm -rf *",
      "del /f /s /q *",
      "git push --force*",
      "git reset --hard*",
      "git clean -fd*",
      "git branch -D main",
      "git branch -D master",
      "drop table *",
      "supabase db reset*"
    ]
  }
}
